# Локальные секреты администратора (Windows). НЕ коммитить.
# Скопируйте:  copy .env.deploy.example .env.deploy
#
# Файл .env.deploy в .gitignore и .cursorignore — не попадёт на GitHub
# и не будет читаться AI-агентом в Cursor.

RESTINFO_SERVER_URL=https://info.r-est.ru

# Вариант A: логин + пароль (скрипт сам получит JWT)
RESTINFO_ADMIN_EMAIL=your@email.com
RESTINFO_ADMIN_PASSWORD=change-me

# Вариант B: готовый JWT (раскомментируйте; пароль тогда не нужен)
# RESTINFO_ADMIN_TOKEN=

# Опционально: удалённый deploy сервера (git pull + docker compose)
# RESTINFO_SSH_HOST=info.r-est.ru
# RESTINFO_SSH_USER=rest-info
